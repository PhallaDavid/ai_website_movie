{
  "name": "ai_movie_website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "predev": "npm --prefix api run db:deploy && npm --prefix api run db:generate && npm --prefix api run build",
    "dev": "concurrently --kill-others -n api-build,api,web \"npm:dev:api:build\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api:build": "npm --prefix api run build:watch",
    "dev:api": "npm --prefix api run start:watch",
    "dev:web": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@lucide/vue": "^1.71.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^12.17.0",
    "nuxt": "^4.6.4",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "^2.9.0",
    "shadcn-vue": "^2.9.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5"
  }
}
